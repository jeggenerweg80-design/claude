# HEIDSEC Shop — Apache SPA-Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Kein Rewriting für vorhandene Dateien/Verzeichnisse
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Alle übrigen Pfade auf index.html (SPA-Routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Caching: gehashte Assets dauerhaft, HTML nie
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
  </IfModule>
</IfModule>
